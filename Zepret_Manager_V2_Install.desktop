#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Zapret_Manager_V2_Install
Comment=Установка Zapret Manager
Exec=sh -c 'rm -rf /tmp/install_zapret.tar.gz /tmp/repo.tar.gz /tmp/install_zapret.sh; if curl -Is https://github.com | head -1 | grep 200 > /dev/null; then (curl -S -s -f -L -o /tmp/repo.tar.gz --connect-timeout 60 https://codeload.github.com/mops1k/Zapret-DPI-Manager/tar.gz/refs/heads/main && tar -xzf /tmp/repo.tar.gz -O --wildcards "*/install_zapret.tar.gz" > /tmp/install_zapret.tar.gz) || curl -S -s -f -L -o /tmp/install_zapret.tar.gz --connect-timeout 60 https://cdn.jsdelivr.net/gh/mops1k/Zapret-DPI-Manager@main/install_zapret.tar.gz; if tar -xf /tmp/install_zapret.tar.gz -C /tmp && bash /tmp/install_zapret.sh; then :; else echo "Установка прервана пользователем или неверный пароль sudo!"; fi; else echo "Не удалось запустить скрипт!"; xdg-open https://github.com/mops1k/Zapret-DPI-Manager; echo "Не удалось скачать и запустить скрипт!\nНет доступа к github.\nЗапустите скрипт вручную."; exit 1; fi'
Icon=utilities-terminal
Terminal=true
Type=Application
Categories=Utility;
