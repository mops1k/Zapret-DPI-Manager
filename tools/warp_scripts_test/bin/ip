#!/bin/bash
# Заглушка ip для стенда WARP: журналирует вызовы и держит «таблицу» маршрутов
# и «маркеры» интерфейсов, чтобы проверять поведение скриптов без реальной сети.
#
# Таблица маршрутов: $WARP_TEST_ROUTES (строки как у настоящего ip).
# Интерфейсы:        $WARP_TEST_IFACES/<имя> (файл-маркер = интерфейс существует).
J="${WARP_TEST_JOURNAL:-/dev/null}"
IFACES="${WARP_TEST_IFACES:-/dev/null/none}"
ROUTES="${WARP_TEST_ROUTES:-/dev/null/none}"
printf '%s ip: argv: %s\n' "$(date +%H:%M:%S)" "$*" >> "$J"

ARGS=()
for a in "$@"; do
    case "$a" in
        -4|-6|-o|-br|-json|-n) ;;
        *) ARGS+=("$a") ;;
    esac
done
OBJ="${ARGS[0]:-}"
ACT="${ARGS[1]:-}"
ARG2="${ARGS[2]:-}"

case "$OBJ $ACT" in
    "route show")
        if [ -z "$ARG2" ] || [ "$ARG2" = "default" ]; then
            echo "default via 192.168.1.1 dev eth0 proto dhcp src 192.168.1.50 metric 100"
        else
            # Пусто, если маршрута нет (настоящий ip тоже печатает пусто и выходит 0).
            grep -F "$ARG2" "$ROUTES" 2>/dev/null || true
        fi
        exit 0
        ;;
    "route replace"|"route add")
        LINE="${ARGS[*]:2}"
        if grep -qF "$ARG2" "$ROUTES" 2>/dev/null; then
            grep -vF "$ARG2" "$ROUTES" > "$ROUTES.tmp" 2>/dev/null || true
            mv "$ROUTES.tmp" "$ROUTES"
            printf '%s ip:   (замена существующего %s)\n' "$(date +%H:%M:%S)" "$ARG2" >> "$J"
        fi
        echo "$LINE" >> "$ROUTES"
        exit 0
        ;;
    "route del")
        LINE="${ARGS[*]:2}"
        if grep -qF "$ARG2" "$ROUTES" 2>/dev/null; then
            grep -vF "$ARG2" "$ROUTES" > "$ROUTES.tmp" 2>/dev/null || true
            mv "$ROUTES.tmp" "$ROUTES"
            printf '%s ip:   (удалён существующий %s)\n' "$(date +%H:%M:%S)" "$ARG2" >> "$J"
        else
            printf '%s ip:   (маршрута %s в таблице не было)\n' "$(date +%H:%M:%S)" "$ARG2" >> "$J"
        fi
        exit 0
        ;;
    "link show")
        if [ -z "$ARG2" ]; then
            n=1
            for f in "$IFACES"/*; do
                [ -e "$f" ] || continue
                echo "$n: $(basename "$f"): <POINTOPOINT,NOARP,UP,LOWER_UP> mtu 1280 qdisc noqueue state UNKNOWN"
                n=$((n + 1))
            done
            exit 0
        fi
        if [ -e "$IFACES/$ARG2" ]; then
            echo "3: $ARG2: <POINTOPOINT,NOARP,UP,LOWER_UP> mtu 1280 qdisc noqueue state UNKNOWN mode DEFAULT group default"
            exit 0
        fi
        echo "Device \"$ARG2\" does not exist." >&2
        exit 1
        ;;
    "link del")
        if [ -e "$IFACES/$ARG2" ]; then
            rm -f "$IFACES/$ARG2"
            printf '%s ip:   (интерфейс %s удалён)\n' "$(date +%H:%M:%S)" "$ARG2" >> "$J"
        else
            printf '%s ip:   (интерфейса %s не было)\n' "$(date +%H:%M:%S)" "$ARG2" >> "$J"
        fi
        exit 0
        ;;
    "link add"|"addr add"|"addr del"|"link set")
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
